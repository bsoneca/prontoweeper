EXPOSE 8090
ENTRYPOINT ["deno","run","--frozen","--cached-only","--config","plugins/omnishell/server/deno.json","--allow-net","--allow-env","--allow-read=/render","plugins/omnishell/server/render.ts"]
RUN deno cache --frozen --config plugins/omnishell/server/deno.json plugins/omnishell/server/render.ts
HEALTHCHECK --interval=1s --timeout=5s --retries=30 --start-period=120s CMD ["httpcheck","http://127.0.0.1:8090/health"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS render_ctxs
