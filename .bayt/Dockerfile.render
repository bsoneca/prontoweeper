FROM denoland/deno:debian-2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432 AS render
ARG BAYT_DIR
WORKDIR /render
COPY --chmod=755 --from=tarampampam/microcheck:1@sha256:79c187c05bfa67518078bf4db117771942fa8fe107dc79a905861c75ddf28dfa /bin/httpcheck /usr/local/bin/httpcheck
COPY --from=plugins_omnishell-runtime-image /interpreter /render/plugins/omnishell/interpreter
COPY --from=plugins_omnishell-runtime-image /server /render/plugins/omnishell/server
COPY --from=prontoweeper-served /served/shell/index.html /render/entry.html
COPY --parents shell/index.html shell/shell.css shell/boot.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/beginner.html shell/screens/beginner.css shell/screens/intermediate.html shell/screens/intermediate.css shell/screens/expert.html shell/screens/expert.css shell/screens/halloffame.html shell/screens/halloffame.css shell/handlers/bump.js shell/handlers/clock.js shell/handlers/sweep.js shell/shared/window.css messages/en.json messages/pt-BR.json ./
