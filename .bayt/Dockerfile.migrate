# generated from bayt.cue — do not edit
FROM libraries_mecha-database-image AS migrate
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.migrate.json ./.bayt/
ENTRYPOINT ["/migrate.sh","/pgroll","00_initdb"]
COPY <<'PGROLL' /pgroll/billing_01.json
{"operations":[{"sql":{"up":"CREATE SCHEMA IF NOT EXISTS billing;\nREVOKE ALL ON SCHEMA billing FROM PUBLIC;\nCREATE TABLE IF NOT EXISTS billing.manage (account uuid PRIMARY KEY, token text NOT NULL, ver bigint NOT NULL DEFAULT 0);\n\nCREATE OR REPLACE FUNCTION billing.sessions_read_only() RETURNS trigger LANGUAGE plpgsql AS $f$\nBEGIN\n  IF current_user IN ('app_user', 'anon') THEN\n    RAISE EXCEPTION 'subscriptions are the billing broker''s to write' USING ERRCODE = 'insufficient_privilege';\n  END IF;\n  RETURN coalesce(NEW, OLD);\nEND $f$;\nDROP TRIGGER IF EXISTS subscription_read_only ON public.subscription;\nCREATE TRIGGER subscription_read_only BEFORE INSERT OR UPDATE OR DELETE ON public.subscription\n  FOR EACH ROW EXECUTE FUNCTION billing.sessions_read_only();\n-- Whatever a session wrote before the trigger stood (a release between its initdb and this\n-- migration): a row the broker did not write is no plan.\nDELETE FROM public.subscription s WHERE s.id <> s.plan || '/' || s.owner_id\n  OR NOT EXISTS (SELECT 1 FROM billing.manage m WHERE m.account = s.owner_id);\n\nCREATE OR REPLACE FUNCTION public.billing_entitle(account uuid, plan text, active boolean, through timestamptz, manage text, ver bigint)\nRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$\nBEGIN\n  -- The constraints by name: a column by its name would be the parameter of that name.\n  INSERT INTO billing.manage AS m (account, token, ver) VALUES (account, manage, ver)\n    ON CONFLICT ON CONSTRAINT manage_pkey DO UPDATE SET token = EXCLUDED.token, ver = EXCLUDED.ver\n    WHERE m.ver < EXCLUDED.ver;\n  INSERT INTO public.subscription AS s (id, plan, active, through, ver, owner_id)\n    VALUES (plan || '/' || account, plan, active, through, ver, account)\n    ON CONFLICT ON CONSTRAINT subscription_pkey DO UPDATE SET active = EXCLUDED.active, through = EXCLUDED.through, ver = EXCLUDED.ver\n    WHERE s.ver < EXCLUDED.ver;\nEND $f$;\nREVOKE ALL ON FUNCTION public.billing_entitle(uuid, text, boolean, timestamptz, text, bigint) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION public.billing_entitle(uuid, text, boolean, timestamptz, text, bigint) TO service;\n\nCREATE OR REPLACE FUNCTION public.billing_manage(account uuid) RETURNS text\nLANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog, public AS $f$\n  SELECT m.token FROM billing.manage m WHERE m.account = billing_manage.account\n$f$;\nREVOKE ALL ON FUNCTION public.billing_manage(uuid) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION public.billing_manage(uuid) TO service;\n\n-- Who a reader is, as the gateway verified their session: what the billing\n-- service asks before it sends anyone to pay or to manage.\nCREATE OR REPLACE FUNCTION public.billing_me() RETURNS json\nLANGUAGE sql STABLE SET search_path = pg_catalog, public AS $f$\n  SELECT json_build_object('account', auth_uid(),\n    'guest', coalesce((nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'guest')::boolean, false))\n$f$;\nREVOKE ALL ON FUNCTION public.billing_me() FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION public.billing_me() TO app_user;\n\nNOTIFY pgrst, 'reload schema';"}}]}
PGROLL
COPY <<'PGROLL' /pgroll/billing_02.json
{"operations":[{"sql":{"up":"CREATE OR REPLACE FUNCTION public.billing_grant(grants json) RETURNS void\nLANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $f$\nBEGIN\n  DELETE FROM public.subscription s WHERE s.ver = 0 AND NOT EXISTS (\n    SELECT 1 FROM json_to_recordset(grants) AS g(account uuid, plan text, through timestamptz) WHERE s.id = g.plan || '/' || g.account);\n  INSERT INTO public.subscription AS s (id, plan, active, through, ver, owner_id)\n    SELECT g.plan || '/' || g.account, g.plan, true, g.through, 0, g.account\n    FROM json_to_recordset(grants) AS g(account uuid, plan text, through timestamptz)\n    ON CONFLICT ON CONSTRAINT subscription_pkey DO UPDATE SET active = true, through = EXCLUDED.through, ver = 0\n    WHERE s.ver = 0 OR NOT (s.active AND s.through > now());\nEND $f$;\nREVOKE ALL ON FUNCTION public.billing_grant(json) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION public.billing_grant(json) TO service;\nNOTIFY pgrst, 'reload schema';"}}]}
PGROLL

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS migrate_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.migrate.yaml .bayt/Dockerfile.migrate .bayt/bayt.migrate.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=prontoweeper-database_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS migrate_bayt
COPY --from=migrate_bayt_ctxs /monorepo /monorepo
